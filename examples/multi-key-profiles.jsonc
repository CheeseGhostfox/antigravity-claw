// Multiple API keys for the antigravity-openai provider.
//
// Keys themselves are added on the gateway host and stored in OpenClaw's
// secret store (never hand-author secrets here):
//
//   openclaw models auth login --provider antigravity-openai --profile-id work --method api-key
//   openclaw models auth login --provider antigravity-openai --profile-id personal --method api-key
//
// The `auth.profiles` block below is optional secret-free metadata (labels /
// order). The interesting part is switching: a model ref with an `@<profile>`
// suffix picks which key to use.
{
  "auth": {
    "profiles": {
      "work": {
        "provider": "antigravity-openai",
        "mode": "api_key",
        "displayName": "Work key",
        "email": "me@company.com"
      },
      "personal": {
        "provider": "antigravity-openai",
        "mode": "api_key",
        "displayName": "Personal key",
        "email": "me@gmail.com"
      }
    },
    "order": {
      "antigravity-openai": ["work", "personal"]
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "antigravity-openai/gpt-5.6-sol@work",
        "fallbacks": ["antigravity/Gemini 3.7 Flash (High)"]
      }
    }
  }
}

// In chat:
//   /keys                     -> one-tap provider/key/model buttons
//   /keys use personal        -> pick a model to run on the personal key
//   /model antigravity-openai/gpt-5.2@personal   (session)
//   /think high                                 (reasoning depth on either route)
