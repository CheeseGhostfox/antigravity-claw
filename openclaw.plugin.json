{
  "id": "antigravity",
  "icon": "https://cdn.simpleicons.org/googlegemini",
  "activation": {
    "onStartup": false,
    "onAgentHarnesses": [
      "antigravity"
    ]
  },
  "enabledByDefault": true,
  "providers": [
    "antigravity",
    "antigravity-openai"
  ],
  "name": "Antigravity CLI + API",
  "description": "Dual-provider Antigravity integration: agy CLI agent harness and OpenAI-compatible API-key model dispatch with hot-switchable backup takeover.",
  "skills": [
    "./skills"
  ],
  "providerCatalogEntry": "./provider-discovery.ts",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "binaryPath": {
        "type": "string",
        "minLength": 1,
        "description": "Explicit path to the agy (Antigravity CLI) executable. Defaults to agy on PATH, then the Windows AppData install location."
      },
      "sandbox": {
        "type": "boolean",
        "default": true,
        "description": "Pass --sandbox to agy so its terminal execution runs with sandbox restrictions enabled."
      },
      "projectPrefix": {
        "type": "string",
        "minLength": 1,
        "default": "openclaw",
        "description": "Stable project-name prefix for agy --project. Session identity is appended."
      }
    }
  },
